# App B — Datadog LLM Observability SDK
# Copy to .env and fill in the values. .env is gitignored.

# --- Datadog (US1) ---
DD_SITE=datadoghq.com
DD_API_KEY=                 # <-- paste your Datadog API key
DD_LLMOBS_ML_APP=bedrock-agentcore-sdk
# Agentless = ship straight to Datadog, no local Datadog Agent needed.
DD_LLMOBS_AGENTLESS_ENABLED=1
# Bridge Strands' native OpenTelemetry spans into ddtrace (zero decoration).
# Set to 0 to see only the auto-instrumented Bedrock calls.
DD_TRACE_OTEL_ENABLED=1

# --- AWS / Bedrock ---
AWS_REGION=ap-southeast-1
# After `aws sso login`, this profile provides credentials automatically.
AWS_PROFILE=ese-sandbox
# Verify this id exists in your account (see repo README, step 3).
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
