# App A — OTLP-native telemetry to Datadog
# Copy to .env and fill in the values. .env is gitignored.

# --- Datadog (US1) ---
DD_SITE=datadoghq.com
DD_API_KEY=            # <-- paste your Datadog API key

# Name you'll search on in Datadog LLM Observability (ml_app).
ML_APP=bedrock-agentcore-otlp

# --- AWS / Bedrock ---
AWS_REGION=ap-southeast-1
# After `aws sso login`, this profile provides credentials automatically.
AWS_PROFILE=ese-sandbox
# Verify this id exists in your account (see repo README, step 3).
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# The OTLP endpoint/headers below are derived automatically in agent.py from
# DD_SITE + DD_API_KEY. Uncomment to override explicitly.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://trace.agent.datadoghq.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=dd-api-key=<KEY>,dd-otlp-source=llmobs
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
